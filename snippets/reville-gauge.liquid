{% doc %}
  Renders the REVILLE semi-circular tachometer gauge + live entry counter.

  Reads the real entry count from a shop-level metafield (namespace `reville`,
  key `total_entries`). That metafield does not exist in the store yet, so this
  honestly renders 0 until it's created — never fabricate a placeholder number
  here (see Reference/CLAUDE.md "Critical — Do Not Fabricate").

  @param {number} [goal] - Target entry pool size used as the gauge's denominator.

  @example
  {% render 'reville-gauge', goal: section.settings.entry_goal %}
{% enddoc %}

{% liquid
  assign current = shop.metafields.reville.total_entries.value | default: 0
  assign goal = goal | default: 340000
  if goal <= 0
    assign goal = 1
  endif

  assign percent = current | times: 1.0 | divided_by: goal
  if percent > 1
    assign percent = 1
  endif
  if percent < 0
    assign percent = 0
  endif
  assign percent = percent | round: 4

  assign dash_offset = 1 | minus: percent

  # Odometer digit count follows the goal's magnitude (e.g. 340000 -> 6 digits)
  # so the display has a stable width to animate within.
  assign digit_count = goal | append: '' | size
  if digit_count < 4
    assign digit_count = 4
  endif

  assign padded_current = current | append: ''
  for i in (1..12)
    if padded_current.size >= digit_count
      break
    endif
    assign padded_current = '0' | append: padded_current
  endfor
  assign digit_chars = padded_current | split: ''
%}

<script src="{{ 'reville-gauge.js' | asset_url }}" type="module" fetchpriority="low"></script>

<reville-gauge-component
  class="reville-gauge"
  data-current="{{ current }}"
  style="
    --reville-gauge-color1: {{ settings.color_palette.color1 }};
    --reville-gauge-color2: {{ settings.color_palette.color2 }};
    --reville-gauge-color3: {{ settings.color_palette.color3 }};
  "
>
  <svg
    class="reville-gauge__dial"
    viewBox="0 0 240 130"
    role="img"
    aria-label="{{ current }} entries toward the giveaway goal"
  >
    <path
      class="reville-gauge__arc-track"
      d="M 20 120 A 100 100 0 0 1 220 120"
      pathLength="1"
      style="stroke: {{ settings.color_palette.color4 }};"
    />
    <path
      ref="arc"
      class="reville-gauge__arc-progress"
      d="M 20 120 A 100 100 0 0 1 220 120"
      pathLength="1"
      style="stroke: {{ settings.color_palette.color6 }}; stroke-dasharray: 1 1; stroke-dashoffset: {{ dash_offset }};"
    />
  </svg>
  <div class="reville-gauge__readout">
    <div class="reville-gauge__odometer" aria-hidden="true">
      {% for char in digit_chars %}
        {% assign pos_from_right = digit_count | minus: forloop.index0 %}
        {% assign pos_mod_3 = pos_from_right | modulo: 3 %}
        {% if forloop.index0 > 0 and pos_mod_3 == 0 %}
          <span class="reville-gauge__comma">,</span>
        {% endif %}
        <span ref="digits[]" class="reville-gauge__digit">{{ char }}</span>
      {% endfor %}
    </div>
    <span class="reville-gauge__label" style="color: {{ settings.color_palette.color5 }};">Total Entries</span>
  </div>
</reville-gauge-component>

{% stylesheet %}
  .reville-gauge {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    width: 100%;
    max-width: 22rem;
  }

  .reville-gauge__dial {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .reville-gauge__arc-track,
  .reville-gauge__arc-progress {
    fill: none;
    stroke-linecap: round;
    stroke-width: 12;
  }

  .reville-gauge__arc-progress {
    transition: stroke-dashoffset 1s ease-out;
  }

  .reville-gauge__readout {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    margin-block-start: -2.5rem;
  }

  .reville-gauge__odometer {
    display: flex;
    align-items: flex-end;
    gap: 2px;
    padding: 4px;
    background: var(--reville-gauge-color1);
    border: 1px solid var(--reville-gauge-color3);
    border-radius: var(--style-border-radius-buttons-outset, 0.375rem);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
  }

  .reville-gauge__digit {
    display: block;
    min-width: 1ch;
    padding: 4px 6px;
    font-family: var(--font-mono--family);
    font-size: clamp(1.75rem, 5vw, 2.75rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.05em;
    color: var(--color-foreground);
    text-align: center;
    font-variant-numeric: tabular-nums;
    background: linear-gradient(
      180deg,
      var(--reville-gauge-color1) 0%,
      var(--reville-gauge-color2) 50%,
      var(--reville-gauge-color1) 100%
    );
    border-block: 1px solid var(--reville-gauge-color3);
    border-radius: 2px;
    box-shadow:
      inset 0 2px 4px rgba(0, 0, 0, 0.5),
      inset 0 -1px 2px rgba(255, 255, 255, 0.05);
  }

  .reville-gauge__comma {
    align-self: flex-end;
    padding-block-end: 6px;
    font-family: var(--font-mono--family);
    font-size: clamp(1.75rem, 5vw, 2.75rem);
    color: var(--reville-gauge-color3);
  }

  .reville-gauge__label {
    font-family: var(--font-accent--family);
    font-size: 0.8rem;
    letter-spacing: var(--letter-spacing-md);
    text-transform: uppercase;
  }
{% endstylesheet %}
