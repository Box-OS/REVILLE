{% comment %}
  Reville catalogue footer banner — matches Stitch "REVILLE Shop — Minimalist
  Dark Data": "MAXIMIZE YOUR CHANCES" callout with a primary CTA. Sits below the
  product grid on the collection template.
{% endcomment %}

<div
  class="section reville-shop-banner spacing-style"
  style="
    {% render 'spacing-style', settings: section.settings %}
    --rsb-color3: {{ settings.color_palette.color3 }};
    --rsb-color5: {{ settings.color_palette.color5 }};
    --rsb-color6: {{ settings.color_palette.color6 }};
    --rsb-color6-rgb: {{ settings.color_palette.color6.rgb }};
    --rsb-background: {{ settings.color_palette.background }};
  "
>
  <aside class="reville-shop-banner__panel">
    <span class="reville-shop-banner__glyph" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="300" height="300" focusable="false">
        <path
          fill="currentColor"
          d="M11 21 3 12h6l-2-9 8 9h-6l2 9Z"
        />
      </svg>
    </span>

    <div class="reville-shop-banner__text">
      {% if section.settings.heading != blank %}
        <h2 class="reville-shop-banner__heading">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.body != blank %}
        <div class="reville-shop-banner__body">{{ section.settings.body }}</div>
      {% endif %}
    </div>

    {% if section.settings.cta_label != blank %}
      <a
        href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}"
        class="reville-shop-banner__cta"
      >
        {{ section.settings.cta_label }}
      </a>
    {% endif %}
  </aside>
</div>

{% stylesheet %}
  .reville-shop-banner {
    max-width: 1280px;
    margin-inline: auto;
    padding-inline: var(--spacing-8, 2rem);
  }

  .reville-shop-banner__panel {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
    padding: 32px;
    background: var(--rsb-background);
    border: 1px solid var(--rsb-color3);
    border-radius: 0.5rem;
    overflow: hidden;
  }

  .reville-shop-banner__glyph {
    position: absolute;
    inset-block-start: -80px;
    inset-inline-end: -80px;
    color: var(--rsb-color6);
    opacity: 0.06;
    pointer-events: none;
  }

  .reville-shop-banner__text {
    position: relative;
    z-index: 1;
    max-width: 36rem;
  }

  .reville-shop-banner__heading {
    font-family: var(--font-heading--family);
    font-weight: 700;
    font-size: clamp(1.75rem, 4vw, 3rem);
    line-height: 1.15;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    margin: 0 0 8px;
  }

  .reville-shop-banner__body {
    font-family: var(--font-body--family);
    font-size: 1rem;
    line-height: 1.6;
    color: var(--rsb-color5);
  }

  .reville-shop-banner__body p {
    margin: 0;
  }

  .reville-shop-banner__cta {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    font-family: var(--font-mono--family);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #fff;
    background: var(--rsb-color6);
    text-decoration: none;
    padding: 16px 32px;
    border-radius: var(--style-border-radius-buttons-outset, 0.25rem);
    box-shadow: 0 4px 15px rgba(var(--rsb-color6-rgb), 0.3);
    transition: opacity 0.2s ease;
  }

  .reville-shop-banner__cta:hover {
    opacity: 0.9;
  }

  @media screen and (min-width: 990px) {
    .reville-shop-banner__panel {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 32px;
      padding: 40px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Reville Shop Banner",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Maximize your chances"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>Every Reville product purchase directly fuels the community and earns you mechanical entries into the grand prize draw. No hidden fees, just pure performance parts and a shot at the ultimate ride.</p>"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "View all products"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA link",
      "info": "Defaults to the All products collection."
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Reville Shop Banner",
      "category": "t:categories.layout"
    }
  ]
}
{% endschema %}
